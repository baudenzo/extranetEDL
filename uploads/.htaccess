# Sécurité : empêcher l'exécution de scripts PHP dans le dossier uploads
php_flag engine off

# Bloquer l'exécution de scripts (Apache 2.4 syntax)
<FilesMatch "\.(php|php3|php4|php5|phtml|pl|py|jsp|asp|sh|cgi)$">
    Require all denied
</FilesMatch>

# Autoriser les types de fichiers autorisés (Apache 2.4 syntax)
<FilesMatch "\.(jpg|jpeg|png|gif|pdf|mp3|mp4|wav|avi|mov|doc|docx|xls|xlsx|webp|ogg|zip|rar|ppt|pptx)$">
    Require all granted
</FilesMatch>
